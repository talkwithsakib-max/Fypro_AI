---
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
import { Image } from "astro:assets";
import SectionHeading from "./ui/SectionHeading.astro";
import mesh1 from "../assets/img/mesh-1.jpg";
import mesh2 from "../assets/img/mesh-2.jpg";
import mesh3 from "../assets/img/mesh-3.jpg";
import mesh4 from "../assets/img/mesh-4.jpg";
import park from "../assets/img/creator-park.png";
import headphones from "../assets/img/creator-headphones.png";
import lashes from "../assets/img/creator-lashes.png";
import serum from "../assets/img/creator-serum.png";
import bottle from "../assets/img/bottle.png";
import roller from "../assets/img/creator-roller.png";
import pov from "../assets/img/creator-pov.png";
import pSerum from "../assets/img/product-serum.png";
// Figma assets (src/assets/figma/feat)
import dnaAvatar from "../assets/figma/feat/dna-avatar.png";
import sparkleDna from "../assets/figma/feat/sparkle-dna.svg";
import play from "../assets/figma/feat/play.svg";
import fire from "../assets/figma/feat/fire.svg";
import sparkleWhite from "../assets/figma/feat/sparkle-white.svg";
import arrowWhite from "../assets/figma/feat/arrow-white18.svg";
import ring from "../assets/figma/feat/ring.svg";
import avatar150 from "../assets/figma/feat/avatar-150.png";
import mic from "../assets/figma/feat/mic.svg";
import curves from "../assets/figma/feat/curves.svg";
import sparkleOpt from "../assets/figma/feat/sparkle-opt.svg";
import checkCyan from "../assets/figma/feat/check-cyan.svg";
import dotPub from "../assets/figma/feat/dot-pub.svg";
import shieldPub from "../assets/figma/feat/shield-pub.svg";

// Geometry is 1:1 with the Figma "Features" bento (node 551:17765).
const traits = [
  { k: "Tone", v: "Warm & funny", w: 188.6 },
  { k: "Hook style", v: "POV / storytime", w: 156.4 },
  { k: "Best topic", v: "Skincare finds", w: 207 },
];
const scenarios = [
  { t: "UGC review" }, { t: "Showcase", dark: true }, { t: "Problem → solution" },
  { t: "POV" }, { t: "ASMR" }, { t: "Proof" },
];
const bars = [8, 16, 22, 12, 26, 18, 10, 20, 14, 8, 18, 12];
const week = [
  { d: "M" }, { d: "T", img: serum }, { d: "W" }, { d: "T", img: lashes },
  { d: "F" }, { d: "S", img: bottle }, { d: "S" },
];
---

<section id="features" class="pt-24 pb-24 sm:pt-[120px] sm:pb-[132px]" aria-labelledby="features-title">
  <div class="container-x">
    <SectionHeading
      id="features-title"
      eyebrow="Features"
      title="From viral ideas to"
      muted="smarter growth."
      lead="Create, publish and optimize every video with AI that understands your content."
    />

    <div class="mt-14 grid gap-5 lg:grid-cols-[780fr_400fr]">
      <!-- Script -->
      <article class="feat-card clip" data-reveal>
        <div data-fit>
          <div class="relative h-[320px] w-[780px]" data-w="780">
            <Image src={mesh4} alt="" width={1520} class="absolute top-2.5 left-2.5 h-[296px] w-[760px] rounded-[18px] object-cover" />
            <div class="float absolute top-10 left-10 flex flex-col gap-3 rounded-[20px] bg-white p-[18px]">
              <div class="flex items-center gap-2.5">
                <Image src={dnaAvatar} alt="" width={72} class="size-9" />
                <div class="leading-normal whitespace-nowrap"><p class="text-[14px] font-bold text-ink">Your Creator DNA</p><p class="text-[11px] font-medium text-muted">From 148 of your posts</p></div>
              </div>
              {traits.map((t) => (
                <div class="flex flex-col gap-[5px]">
                  <p class="flex h-4 w-[230px] justify-between text-[12px] leading-normal whitespace-nowrap"><span class="font-medium text-muted">{t.k}</span><span class="font-semibold text-ink">{t.v}</span></p>
                  <span class="relative h-[5px] w-[230px] overflow-hidden rounded-[3px] bg-[#ededf0]"><span class="absolute inset-y-0 left-0 rounded-[3px] bg-gradient-to-r from-cyan to-pink" style={`width:${t.w}px`}></span></span>
                </div>
              ))}
            </div>
            <div class="dark-float absolute top-[60px] left-[370px] flex flex-col gap-3 rounded-[20px] bg-ink p-[18px]">
              <p class="flex items-center gap-1.5"><img src={sparkleDna.src} alt="" class="size-3.5" /><span class="text-[12px] leading-normal font-semibold whitespace-nowrap text-white/75">New script · in your voice</span></p>
              <div class="flex flex-col gap-[3px]"><p class="text-[10px] leading-normal font-bold text-pink">Hook</p><p class="w-[300px] text-[13px] leading-[18px] font-medium text-white">“POV: you found the serum that sold out in 48 hrs…”</p></div>
              <div class="flex flex-col gap-[3px]"><p class="text-[10px] leading-normal font-bold text-cyan">Body</p><p class="w-[300px] text-[13px] leading-[18px] font-medium text-white">Show texture → before/after → price reveal</p></div>
              <div class="flex flex-col gap-[3px] text-white"><p class="text-[10px] leading-normal font-bold">CTA</p><p class="w-[300px] text-[13px] leading-[18px] font-medium">“Linked in my store — grab it before it’s gone”</p></div>
            </div>
          </div>
        </div>
        <div class="feat-text" style="--tt:326px">
          <span class="tag-dark">Script</span>
          <h3>Creator DNA viral scripting</h3>
          <p class="body max-w-[716px]">Decode the hooks and structures behind viral TikToks, then write new ideas and scripts in your own voice, for your own audience.</p>
        </div>
      </article>

      <!-- Ideas -->
      <article class="feat-card open" data-reveal style="--d:100ms">
        <div data-fit>
          <div class="relative h-[320px] w-[400px]" data-w="400">
            <Image src={mesh1} alt="" width={760} class="absolute top-2.5 left-2.5 h-[296px] w-[380px] rounded-[18px] object-cover" />
            <!-- Deck shuffle (same motion as How it works · card 02): right → front, front → left, left round the back -->
            <div class="absolute inset-0 z-0" data-fdeck>
              {[{ img: lashes, v: "2.4M" }, { img: headphones, v: "1.8M" }, { img: park, v: "3.1M" }].map((d, i) => (
                <div class="fdeck-card video absolute overflow-hidden rounded-[14px]" data-pos={["c", "r", "l"][i]} style="left:130px;top:30px;width:140px;height:250px">
                  <Image src={d.img} alt="" width={280} class="size-full object-cover" />
                  <span class="views absolute top-3 left-2.5 flex items-center gap-1 rounded-full bg-black/50 px-2 py-1 text-[11px] leading-normal font-bold text-white shadow-[inset_0_1px_0_#ffffff29,0_4px_10px_-2px_#12142440]"><img src={play.src} alt="" class="size-[11px]" />{d.v}</span>
                </div>
              ))}
            </div>
            <span class="chip-xs absolute top-[258px] left-[121.5px] flex items-center gap-1.5 rounded-full bg-white px-3 py-[7px]"><img src={fire.src} alt="" class="size-[13px]" /><span class="text-[12px] leading-normal font-semibold whitespace-nowrap text-ink">Trending in Skincare</span></span>
          </div>
        </div>
        <div class="feat-text" style="--tt:326px">
          <span class="tag-dark">Ideas</span>
          <h3>Personalized viral inspiration</h3>
          <p class="body max-w-[336px]">Trending videos, popular content and proven hooks — filtered for your niche.</p>
        </div>
      </article>
    </div>

    <div class="mt-5 grid gap-5 lg:grid-cols-[387fr_387fr_386fr]">
      <!-- Video -->
      <article class="feat-card clip" data-reveal>
        <div data-fit>
          <div class="relative h-[320px] w-[387px]" data-w="387">
            <Image src={mesh2} alt="" width={740} class="absolute top-2.5 left-2.5 h-[296px] w-[367px] rounded-[18px] object-cover" />
            <!-- Preview switches with the active scenario chip: same Glow Serum, different video format -->
            <div class="float absolute top-[34px] left-[133.5px] h-[150px] w-[120px] overflow-hidden rounded-[20px] bg-[#fbefb6]" data-scn-preview>
              <!-- each format gets its own visual language, same Glow Serum -->
              <div class="scn-view absolute inset-0" data-scn="0">
                <Image src={serum} alt="" width={240} class="size-full object-cover object-[50%_22%]" />
                <span class="absolute top-2 left-2 rounded-md bg-white px-1.5 py-0.5 text-[9px] font-bold text-ink">★★★★★</span>
                <span class="absolute top-8 right-2 rounded-[10px] rounded-br-sm bg-white px-2 py-1 text-[9px] font-semibold text-ink shadow">honest review 💬</span>
              </div>
              <div class="scn-view on absolute inset-0 grid place-items-center bg-[#fbefb6]" data-scn="1">
                <Image src={pSerum} alt="" width={240} class="scn-spin size-[115%] max-w-none object-cover" />
              </div>
              <div class="scn-view absolute inset-0" data-scn="2">
                <Image src={serum} alt="" width={240} class="size-full object-cover object-[50%_22%]" />
                <div class="scn-before absolute inset-0 overflow-hidden"><Image src={serum} alt="" width={240} class="size-full object-cover object-[50%_22%] grayscale brightness-75" /></div>
                <span class="scn-divider absolute inset-y-0 w-0.5 bg-white"></span>
                <span class="absolute top-2 left-1.5 rounded bg-black/60 px-1 text-[8px] font-bold text-white">BEFORE</span>
                <span class="absolute top-2 right-1.5 rounded bg-pink px-1 text-[8px] font-bold text-white">AFTER</span>
              </div>
              <div class="scn-view absolute inset-0" data-scn="3">
                <Image src={pov} alt="" width={240} class="scn-hand size-full object-cover object-[50%_22%]" />
                <span class="absolute inset-x-1 top-[38%] text-center text-[11px] leading-tight font-extrabold text-white [text-shadow:0_1px_3px_#000c]">POV: you found it first</span>
              </div>
              <div class="scn-view absolute inset-0" data-scn="4">
                <video src={`${BASE}/videos/serum-drops.mp4`} muted loop playsinline preload="none" class="size-full object-cover"></video>
                <span class="absolute top-2 left-2 flex h-4 items-end gap-[2px]">{[6, 11, 8, 14, 7, 12, 9].map((h, i) => <i class="scn-eq w-[2px] rounded-full bg-white" style={`height:${h}px;animation-delay:${i * -120}ms`}></i>)}</span>
                <span class="absolute top-2 right-2 rounded bg-black/50 px-1 text-[8px] font-bold text-white">🎧 ASMR</span>
              </div>
              <div class="scn-view absolute inset-0" data-scn="5">
                <Image src={lashes} alt="" width={240} class="size-full object-cover object-[50%_22%] brightness-[0.55]" />
                <div class="absolute inset-x-2 top-3 rounded-lg bg-white/95 p-1.5 text-[9px] leading-tight text-ink">
                  <p class="font-bold">✓ 1,240 sold</p><p class="font-bold text-[#0a8f8b]">★ 4.9 · 312 reviews</p><p class="text-muted">Sold out twice</p>
                </div>
              </div>
              <div class="absolute top-[97px] left-2 z-10 rounded-[10px] bg-white/[0.92] px-2 py-1.5 leading-normal whitespace-nowrap"><p class="text-[13px] font-bold text-ink">Glow Serum</p><p class="text-[12px] font-semibold text-ink/70">$24.00</p></div>
            </div>
            <div class="absolute top-[206px] left-[33.5px] flex w-[320px] flex-wrap content-start justify-center gap-2" data-chips>
              {scenarios.map((c) => (
                <span class:list={["scn rounded-full px-3 py-[7px] text-[12px] leading-normal font-semibold whitespace-nowrap", c.dark && "on"]}>{c.t}</span>
              ))}
            </div>
          </div>
        </div>
        <div class="feat-text" style="--tt:326px">
          <span class="tag-dark">Video</span>
          <h3>Shoppable videos, any scenario</h3>
          <p class="body max-w-[323px]">UGC, showcases, problem–solution, POV, ASMR and proof videos for every product.</p>
        </div>
      </article>

      <!-- Remix -->
      <article class="feat-card open" data-reveal style="--d:100ms">
        <div data-fit>
          <div class="relative h-[320px] w-[387px]" data-w="387">
            <Image src={mesh3} alt="" width={740} class="absolute top-2.5 left-2.5 h-[273px] w-[367px] rounded-[18px] object-cover" />
            <div class="video absolute top-12 left-11 h-[220px] w-32 overflow-hidden rounded-[14px]">
              <Image src={roller} alt="" width={256} class="size-full object-cover object-[50%_22%]" />
              <span class="chip-xs absolute top-2 left-2 rounded-full bg-white px-3 py-[7px] text-[12px] leading-normal font-semibold text-ink">Example</span>
              <span class="vid-label absolute bottom-2 left-2 flex items-center gap-1 rounded-full px-2 py-[3px] text-[10px] leading-normal font-semibold whitespace-nowrap text-white"><svg class="size-2" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 2v8l6.5-4z" fill="currentColor"/></svg>2.1M views</span>
            </div>
            <div class="video absolute top-12 left-[214px] h-[220px] w-32 overflow-hidden rounded-[14px]">
              <Image src={serum} alt="" width={256} class="size-full object-cover object-[50%_20%]" />
              <span class="vid-label absolute bottom-2 left-2 flex items-center gap-1 rounded-full px-2 py-[3px] text-[10px] leading-normal font-semibold whitespace-nowrap text-white"><span class="size-1.5 rounded-full bg-cyan"></span>Same hook</span>
              <span class="f-scan pointer-events-none absolute inset-x-0 top-0 h-16"></span>
              <span class="f-shimmer absolute top-2 left-2 flex items-center gap-1.5 overflow-hidden rounded-full bg-pink px-3 py-[7px] text-[12px] leading-normal font-semibold whitespace-nowrap text-white shadow-[inset_0_1px_0_#ffffff,0_4px_10px_-2px_#12142412,0_1px_2px_#1214240f]"><img src={sparkleWhite.src} alt="" class="size-[13px]" />Your remix</span>
            </div>
            <span class="dark-float f-pulse absolute top-[138px] left-[173.5px] grid size-10 place-items-center rounded-[20px] bg-ink"><img src={arrowWhite.src} alt="" class="size-[18px]" /></span>
          </div>
        </div>
        <div class="feat-text" style="--tt:303px">
          <span class="tag-dark">Remix</span>
          <h3>Seedance 2.0 video remix</h3>
          <p class="body max-w-[323px]">Remix any AI Studio example with your own product, character and assets into a stable, multi-shot video.</p>
        </div>
      </article>

      <!-- Avatar -->
      <article class="feat-card clip" data-reveal style="--d:200ms">
        <div data-fit>
          <div class="relative h-[320px] w-[386px]" data-w="386">
            <Image src={mesh4} alt="" width={740} class="absolute top-2.5 left-2.5 h-[273px] w-[366px] rounded-[18px] object-cover" />
            <img src={ring.src} alt="" class="absolute top-[30px] left-[108px] size-[170px]" />
            <Image src={avatar150} alt="" width={300} class="absolute top-10 left-[118px] size-[150px]" />
            <div class="float absolute top-[218px] left-[92px] flex items-center gap-2.5 rounded-full bg-white px-3.5 py-2">
              <span class="grid size-[26px] place-items-center rounded-[14px] bg-pink"><img src={mic.src} alt="" class="size-3.5" /></span>
              <span class="flex items-center gap-[3px]">{bars.map((h, i) => <i class="wave w-[3px] rounded-[2px] bg-ink" style={`height:${h}px;animation-delay:${i * -90}ms`}></i>)}</span>
              <span class="text-[12px] leading-normal font-semibold whitespace-nowrap text-ink">Your voice</span>
            </div>
          </div>
        </div>
        <div class="feat-text" style="--tt:303px">
          <span class="tag-dark">Avatar</span>
          <h3>Personal AI avatar</h3>
          <p class="body max-w-[322px]">One photo and a short voice clip — a consistent look and voice for talking-head videos, no re-filming.</p>
        </div>
      </article>
    </div>

    <div class="mt-5 grid gap-5 lg:grid-cols-[780fr_400fr]">
      <!-- Optimize -->
      <article class="feat-card clip" data-reveal>
        <div data-fit>
          <div class="relative h-[340px] w-[780px]" data-w="780">
            <Image src={mesh1} alt="" width={1520} class="absolute top-2.5 left-2.5 h-[319px] w-[760px] rounded-[18px] object-cover" />
            <div class="float absolute top-9 left-10 h-[250px] w-[470px] overflow-hidden rounded-[20px] bg-white">
              <p class="absolute top-4 left-5 text-[13px] leading-normal font-bold text-ink">Viewer retention</p>
              <p class="absolute top-[18px] left-[300px] flex gap-3.5 text-[11px] leading-normal whitespace-nowrap"><span class="font-medium text-muted">— — Before</span><span class="font-semibold text-pink">—— With Fypro</span></p>
              <img src={curves.src} alt="" class="absolute top-[60px] left-5 h-40 w-[430px]" />
              <span class="chip-xs absolute top-[150px] left-[110px] flex items-center gap-1.5 rounded-full bg-white px-3 py-[7px]"><img src={sparkleOpt.src} alt="" class="size-[13px]" /><span class="text-[12px] leading-normal font-semibold whitespace-nowrap text-ink">Drop-off at 0:03 — fixed</span></span>
            </div>
            <div class="dark-float absolute top-[60px] left-[540px] flex flex-col gap-1.5 rounded-[20px] bg-ink px-5 py-[18px]">
              <p class="text-[12px] leading-normal font-medium text-white/65">Pre-post score</p>
              <p class="text-[48px] leading-normal font-semibold tracking-[-1.92px] text-white">92</p>
              {["Hook lands in 1.2s", "Caption + hashtags ready", "Best time: 7:00 PM"].map((t) => (
                <p class="flex items-center gap-1.5"><img src={checkCyan.src} alt="" class="size-[13px]" /><span class="text-[12px] leading-normal font-medium whitespace-nowrap text-white/85">{t}</span></p>
              ))}
            </div>
          </div>
        </div>
        <div class="feat-text" style="--tt:349px">
          <span class="tag-dark">Optimize</span>
          <h3>AI video optimization</h3>
          <p class="body max-w-[716px]">Spot issues before you publish, then use real performance data to keep improving every video.</p>
        </div>
      </article>

      <!-- Publish -->
      <article class="feat-card clip" data-reveal style="--d:100ms">
        <div data-fit>
          <div class="relative h-[320px] w-[400px]" data-w="400">
            <Image src={mesh2} alt="" width={760} class="absolute top-2.5 left-2.5 h-[296px] w-[380px] rounded-[18px] object-cover" />
            <div class="float absolute top-10 left-[39px] flex flex-col gap-2.5 rounded-[20px] bg-white p-4">
              <p class="text-[13px] leading-normal font-bold whitespace-nowrap text-ink">Planner · This week</p>
              <div class="flex gap-1.5">
                {week.map((d) => (
                  <div class="flex flex-col items-center gap-1.5">
                    <span class="text-[11px] leading-normal font-semibold text-muted">{d.d}</span>
                    {d.img ? <Image src={d.img} alt="" width={72} class="h-[60px] w-9 rounded-[10px] object-cover" /> : <span class="h-[60px] w-9 rounded-[10px] bg-[#f4f4f7]"></span>}
                  </div>
                ))}
              </div>
              <span class="chip-xs flex w-fit items-center gap-2 rounded-xl bg-[#f4f4f7] px-2.5 py-2"><img src={dotPub.src} alt="" class="size-2" /><span class="text-[12px] leading-normal font-semibold whitespace-nowrap text-ink">Thu 7:00 PM · scheduled</span></span>
            </div>
            <span class="chip-dark absolute top-[210px] left-[129px] flex items-center gap-1.5 rounded-full bg-ink px-3 py-[7px]"><img src={shieldPub.src} alt="" class="size-[13px]" /><span class="text-[12px] leading-normal font-semibold whitespace-nowrap text-white">Official TikTok API</span></span>
          </div>
        </div>
        <div class="feat-text" style="--tt:326px">
          <span class="tag-dark">Publish</span>
          <h3>TikTok official publishing</h3>
          <p class="body max-w-[336px]">Connect securely through TikTok’s official API and schedule every post in Planner.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .feat-card {
    position: relative;
    border-radius: 28px;
    background: #fff;
    overflow: hidden;
  }
  /* Figma renders spread only on clipped frames; unclipped cards get the full (0-spread) glow */
  .feat-card.clip {
    box-shadow: var(--shadow-card);
  }
  .feat-card.open {
    box-shadow: var(--shadow-card-open);
  }
  .float {
    box-shadow: inset 0 1px 0 #fff, var(--shadow-float);
  }
  .dark-float {
    box-shadow: inset 0 1px 0 #ffffff29, var(--shadow-dark-chip);
  }
  .video {
    box-shadow: var(--shadow-video);
  }
  .chip-xs {
    box-shadow: inset 0 1px 0 #fff, var(--shadow-xs);
  }
  .chip-dark {
    box-shadow: inset 0 1px 0 #ffffff29, 0 4px 10px -2px #12142440;
  }
  .feat-text {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 12px 32px 32px;
  }
  .feat-text h3 {
    font-size: 22px;
    line-height: normal;
    font-weight: 600;
    letter-spacing: -0.44px;
    color: var(--color-ink);
  }
  .feat-text .body {
    font-size: 15px;
    line-height: 23px;
    color: var(--color-muted);
  }
  .tag-dark {
    border-radius: 999px;
    background: var(--color-ink);
    padding: 3px 9px;
    font-size: 11px;
    line-height: normal;
    font-weight: 700;
    color: #fff;
  }
  /* ---- Ideas deck / Video chips / Remix scan (animate only while the section is visible: .f-live) ---- */
  .fdeck-card { transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.9s, filter 0.9s; }
  .fdeck-card[data-pos="c"] { transform: none; z-index: 3; }
  .fdeck-card[data-pos="l"] { transform: translate(-111.3px, 9.7px) rotate(6deg) scale(0.857); z-index: 1; }
  .fdeck-card[data-pos="r"] { transform: translate(110.65px, -2.8px) rotate(-6deg) scale(0.857); z-index: 2; }
  .fdeck-card .views { transition: opacity 0.4s; }
  .fdeck-card:not([data-pos="c"]) .views { opacity: 0; }
  .fdeck-card.is-wrapping { opacity: 0.4; filter: blur(2px); z-index: 0; }
  .scn {
    background: #fff;
    color: var(--color-ink);
    box-shadow: inset 0 1px 0 #fff, var(--shadow-xs);
    transition: background 0.45s ease, color 0.45s ease, box-shadow 0.45s ease, translate 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .scn.on {
    background: var(--color-ink);
    color: #fff;
    translate: 0 -2px;
    box-shadow: inset 0 1px 0 #ffffff29, 0 6px 14px -4px #12142466;
  }
  .scn-view { opacity: 0; scale: 1.06; transition: opacity 0.6s ease, scale 0.9s cubic-bezier(0.22, 1, 0.36, 1); }
  .scn-view.on { opacity: 1; scale: 1; }
  /* format-specific motion (only while visible) */
  .scn-before { width: 50%; }
  .scn-divider { left: 50%; }
  :global(.f-live) .scn-view.on .scn-spin { animation: scn-spin 2.2s ease-in-out infinite alternate; }
  :global(.f-live) .scn-view.on .scn-before { animation: scn-wipe 2.2s ease-in-out infinite alternate; }
  :global(.f-live) .scn-view.on .scn-divider { animation: scn-div 2.2s ease-in-out infinite alternate; }
  :global(.f-live) .scn-view.on .scn-hand { animation: scn-hand 2.2s ease-in-out infinite; }
  :global(.f-live) .scn-view.on .scn-eq { animation: scn-eq 0.7s ease-in-out infinite alternate; }
  @keyframes scn-spin { from { rotate: -6deg; scale: 1; } to { rotate: 6deg; scale: 1.08; } }
  @keyframes scn-wipe { from { width: 80%; } to { width: 25%; } }
  @keyframes scn-div { from { left: 80%; } to { left: 25%; } }
  @keyframes scn-hand { 0%, 100% { translate: 0 0; rotate: 0deg; } 50% { translate: 2px -2px; rotate: 1deg; } }
  @keyframes scn-eq { from { scale: 1 0.4; } to { scale: 1 1; } }
  .f-scan {
    opacity: 0;
    background: linear-gradient(180deg, #25f4ee00 0%, #25f4ee55 55%, #fe2c5588 100%);
    mix-blend-mode: screen;
  }
  .f-shimmer::after {
    content: "";
    position: absolute;
    inset: 0;
    translate: -120% 0;
    background: linear-gradient(100deg, transparent 30%, #ffffff8c 50%, transparent 70%);
  }
  :global(.f-live) .f-scan { animation: f-scan 3s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  :global(.f-live) .f-shimmer::after { animation: f-shimmer 3s ease-in-out infinite 0.8s; }
  :global(.f-live) .f-pulse { animation: f-pulse 3s ease-out infinite; }
  @keyframes f-scan { 0% { top: -64px; opacity: 0; } 15% { opacity: 1; } 75% { opacity: 1; } 100% { top: 220px; opacity: 0; } }
  @keyframes f-shimmer { 0% { translate: -120% 0; } 40%, 100% { translate: 120% 0; } }
  @keyframes f-pulse {
    0% { box-shadow: inset 0 1px 0 #ffffff29, var(--shadow-dark-chip), 0 0 0 0 #fe2c5566; }
    70%, 100% { box-shadow: inset 0 1px 0 #ffffff29, var(--shadow-dark-chip), 0 0 0 12px #fe2c5500; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.f-live) .f-scan, :global(.f-live) .f-shimmer::after, :global(.f-live) .f-pulse { animation: none; }
    .fdeck-card, .scn { transition: none; }
  }
  .wave {
    animation: wave 1.1s ease-in-out infinite;
  }
  @keyframes wave {
    0%, 100% { transform: scaleY(0.55); }
    50% { transform: scaleY(1); }
  }
  @media (min-width: 1024px) {
    .feat-card {
      height: 470px;
    }
    .feat-text {
      position: absolute;
      left: 0;
      top: var(--tt);
      padding: 0 32px;
    }
    .feat-text h3 {
      white-space: nowrap;
    }
  }
  .vid-label { background: rgb(22 24 35 / 0.5); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); box-shadow: inset 0 1px 0 #ffffff26; }
</style>

<script>
  const feat = document.getElementById("features");
  if (feat) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const deck = [...feat.querySelectorAll<HTMLElement>("[data-fdeck] .fdeck-card")];
    const chips = [...feat.querySelectorAll<HTMLElement>("[data-chips] .scn")];
    let k = chips.findIndex((c) => c.classList.contains("on"));
    let t1: number | undefined, t2: number | undefined;
    const shuffle = () => {
      deck.forEach((c) => {
        const p = c.dataset.pos;
        c.classList.toggle("is-wrapping", p === "l");
        c.dataset.pos = p === "r" ? "c" : p === "c" ? "l" : "r";
      });
      setTimeout(() => deck.forEach((c) => c.classList.remove("is-wrapping")), 900);
    };
    const views = [...feat.querySelectorAll<HTMLElement>("[data-scn-preview] .scn-view")];
    const nextChip = () => {
      chips[k]?.classList.remove("on");
      k = (k + 1) % chips.length;
      chips[k]?.classList.add("on");
      views.forEach((v, i) => {
        v.classList.toggle("on", i === k);
        const vid = v.querySelector("video");
        if (vid) i === k ? vid.play().catch(() => {}) : vid.pause();
      });
    };
    new IntersectionObserver(([e]) => {
      feat.classList.toggle("f-live", e.isIntersecting && !reduce);
      clearInterval(t1); clearInterval(t2);
      if (e.isIntersecting && !reduce) {
        t1 = window.setInterval(shuffle, 2800);
        t2 = window.setInterval(nextChip, 2200);
      }
    }, { threshold: 0.1 }).observe(feat);
  }
</script>
