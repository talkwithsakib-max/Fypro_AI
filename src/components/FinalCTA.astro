---
import { Image } from "astro:assets";
import HandleForm from "./ui/HandleForm.astro";
import AvatarStack from "./ui/AvatarStack.astro";
import roller from "../assets/img/creator-roller.png";
import lashes from "../assets/img/creator-lashes.png";
import pov from "../assets/img/creator-pov.png";
import serum from "../assets/img/creator-serum.png";
import bottle from "../assets/img/bottle.png";
import headphones from "../assets/img/creator-headphones.png";
import city from "../assets/img/creator-city.png";

const reel = [
  { img: roller, views: "842K", text: "POV:" },
  { img: lashes, views: "1.2M" },
  { img: pov, views: "2.1M", text: "LINK IN BIO" },
  { img: serum, views: "3.4M", text: "SOLD OUT" },
  { img: bottle, views: "615K" },
  { img: headphones, views: "980K", text: "WAIT, THESE JUST" },
  { img: city, views: "1.6M" },
];
const mid = (reel.length - 1) / 2;
// Card geometry measured from the Figma "Video fan" frame (1440-wide stage, card centre x/y, size, tilt)
const place = [
  { x: 172, y: 338, w: 170, h: 288, r: -10 },
  { x: 353, y: 272, w: 168, h: 280, r: -7 },
  { x: 530, y: 229, w: 176, h: 306, r: -4 },
  { x: 720, y: 201, w: 190, h: 338, r: 0 },
  { x: 910, y: 229, w: 176, h: 306, r: 4 },
  { x: 1087, y: 272, w: 168, h: 280, r: 7 },
  { x: 1268, y: 338, w: 170, h: 288, r: 10 },
];
---

<div id="cta" class="cta-wrap relative z-10 -mb-px">
  <div class="cta-glow-top" aria-hidden="true"></div>
  <section class="relative px-4 pt-24 text-center text-white sm:pt-[130px]" aria-labelledby="cta-title">
    <div data-reveal>
      <p class="eyebrow !text-white/60">Ready when you are</p>
      <h2 id="cta-title" class="mx-auto mt-6 max-w-[900px] font-display text-[42px] leading-[1] font-semibold tracking-[-0.055em] sm:text-[64px] lg:text-[82px] lg:leading-[1.02]">
        One handle is all it takes.<br class="hidden sm:block" /> We’ll do the <span class="text-gradient-rest">rest</span>.
      </h2>
      <p class="mx-auto mt-[26px] max-w-[620px] text-[16px] text-white/65 sm:text-[18px]">Connect your TikTok in 30 seconds. Your first AI growth plan is on us.</p>
    </div>
    <div class="mt-[26px]" data-reveal style="--d:120ms">
      <HandleForm id="cta-handle" dark large glow />
    </div>
    <div class="mt-[26px] flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-[13.5px] text-white/65" data-reveal style="--d:200ms">
      <AvatarStack size={30} count={4} ring="#0b0b0d" />
      <span>Join <b class="font-semibold text-white">30,000+ creators</b> already running Fypro</span>
      <span class="hidden size-1 rounded-full bg-white/30 sm:block"></span>
      <span class="flex items-center gap-1.5">
        <svg class="size-3.5 text-cyan" viewBox="0 0 16 16"><path d="M8 1 2.5 3v4.5C2.5 11 5 13.6 8 15c3-1.4 5.5-4 5.5-7.5V3z" fill="currentColor"/><path d="m5.5 8 1.8 1.8L10.8 6" stroke="#0b0b0d" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
        Official TikTok API
      </span>
    </div>

    <!-- Video fan: cards fade into the glows and run into the footer -->
    <div class="fan-wrap relative mx-auto mt-[78px] h-[440px] max-w-[1440px]" aria-hidden="true">
      <span class="fan-glow fan-glow-l"></span>
      <span class="fan-glow fan-glow-r"></span>
      <div class="fan-row absolute left-1/2 top-0 h-[440px] w-[1440px] -translate-x-1/2">
        {reel.map((r, i) => {
          const o = i - mid;
          const p = place[i];
          const left = p.x - p.w / 2;
          const top = p.y - p.h / 2;
          return (
            <figure
              class="fan-card absolute overflow-hidden rounded-[22px]"
              style={`left:${left}px;top:${top}px;width:${p.w}px;height:${p.h}px;--o:${o};--r:${p.r}deg;z-index:${10 - Math.abs(o)}`}
            >
              <Image src={r.img} alt="" width={380} class="size-full object-cover" />
              {r.text && <span class="absolute inset-x-0 top-[44%] text-center text-[17px] font-bold [text-shadow:0_2px_10px_#000a]">{r.text}</span>}
              <span class="absolute bottom-[26%] left-4 text-[12px] font-medium text-white/80">▶ {r.views}</span>
            </figure>
          );
        })}
      </div>
      <span class="fan-fade" aria-hidden="true"></span>
    </div>
  </section>
</div>

<style>
  .cta-wrap {
    background: #0b0b0d;
    border-radius: 36px 36px 0 0;
    overflow: hidden;
  }
  .cta-glow-top {
    position: absolute;
    left: 50%;
    top: -260px;
    width: 700px;
    height: 380px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: #ffffff;
    opacity: 0.06;
    filter: blur(80px);
    pointer-events: none;
  }
  .fan-glow {
    position: absolute;
    top: -30px;
    width: 640px;
    height: 420px;
    border-radius: 50%;
    filter: blur(70px);
    pointer-events: none;
  }
  .fan-glow-l {
    left: calc(50% - 600px);
    background: radial-gradient(closest-side, #12534f 0%, #0d3836 55%, transparent 100%);
  }
  .fan-glow-r {
    right: calc(50% - 600px);
    background: radial-gradient(closest-side, #5a1424 0%, #3a0e19 55%, transparent 100%);
  }
  .fan-fade {
    position: absolute;
    left: 50%;
    bottom: -1px;
    z-index: 20;
    width: 100vw;
    height: 34%;
    transform: translateX(-50%);
    pointer-events: none;
    background: linear-gradient(180deg, #0b0b0d00 0%, #0b0b0dcc 50%, #0b0b0d 85%);
  }
  .fan-row {
    perspective: 1400px;
  }
  .fan-card {
    transform: rotateY(calc(var(--o) * -3deg)) rotate(var(--r));
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 58%, transparent 90%);
    mask-image: linear-gradient(180deg, #000 0%, #000 58%, transparent 90%);
    box-shadow: 0 0 0 1px #ffffff12;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .fan-card:hover {
    transform: translateY(-14px) rotateY(calc(var(--o) * -3deg)) rotate(var(--r));
  }
  @media (max-width: 1100px) {
    .fan-row { zoom: 0.8; }
    .fan-glow-l { left: -10%; }
    .fan-glow-r { right: -10%; }
  }
  @media (max-width: 760px) {
    .fan-row { zoom: 0.56; }
    .fan-wrap { height: 300px; margin-top: 56px; }
    .fan-glow { width: 420px; height: 300px; }
  }
  @media (max-width: 420px) {
    .fan-row { zoom: 0.46; }
    .fan-wrap { height: 250px; }
  }
</style>
