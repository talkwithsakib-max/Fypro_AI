---
import Arrow from "./Arrow.astro";
interface Props { dark?: boolean; large?: boolean; glow?: boolean; id: string; class?: string }
const { dark = false, large = false, glow = false, id, class: cls = "" } = Astro.props;
---
<form
  class:list={[
    "handle-form group relative mx-auto flex w-full items-center gap-2 rounded-full pl-5 transition-shadow",
    large ? "max-w-[580px] p-[7px]" : "max-w-[560px] p-2",
    dark ? "bg-white/[0.07] ring-1 ring-white/10" : "bg-white",
    cls,
  ]}
  style={dark ? "box-shadow: var(--shadow-dark-float)" : "box-shadow: inset 0 1px 0 #fff, var(--shadow-glow)"}
  action="#"
  novalidate
>
  <label for={id} class="sr-only">Your TikTok handle</label>
  <span class="text-[19px] font-semibold text-pink" aria-hidden="true">@</span>
  <input
    id={id}
    name="handle"
    type="text"
    autocomplete="off"
    spellcheck="false"
    placeholder="yourtiktokhandle"
    class:list={[
      "min-w-0 flex-1 bg-transparent text-[16px] outline-none sm:text-[17px]",
      dark ? "text-white placeholder:text-white/45" : "text-ink placeholder:text-[#9a9ba6]",
    ]}
  />
  <button
    type="submit"
    class:list={[
      "inline-flex shrink-0 items-center gap-3 rounded-full py-1.5 pr-1.5 pl-4 text-[15px] font-medium transition-transform duration-300 hover:-translate-y-px sm:pl-5",
      large && "h-[52px] sm:pl-6",
      glow && "glow-btn",
      dark ? "bg-white text-ink" : "btn-dark !py-1.5",
    ]}
  >
    <span class="hidden sm:inline">Get my growth plan</span>
    <span class="sm:hidden">Get plan</span>
    <span class:list={["btn-orb", large && "!size-10"]}><Arrow /></span>
  </button>
  <p class="form-msg pointer-events-none absolute -bottom-8 left-0 right-0 text-center text-[13px] opacity-0 transition-opacity" aria-live="polite"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>(".handle-form").forEach((form) => {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector("input")!;
      const msg = form.querySelector<HTMLElement>(".form-msg")!;
      const v = input.value.trim().replace(/^@/, "");
      msg.textContent = v ? `Building a growth plan for @${v}…` : "Enter your TikTok handle to start.";
      msg.style.color = v ? "#14a39c" : "#fe2c55";
      msg.style.opacity = "1";
      if (!v) input.focus();
    });
  });
</script>
