---
import { Image } from "astro:assets";
import lashes from "../../assets/img/creator-lashes.png";
import pov from "../../assets/img/creator-pov.png";
import serum from "../../assets/img/creator-serum.png";
import city from "../../assets/img/creator-city.png";
import roller from "../../assets/img/creator-roller.png";

interface Props { size?: number; count?: number; ring?: string; class?: string }
const { size = 24, count = 4, ring = "#fff", class: cls = "" } = Astro.props;
const imgs = [lashes, serum, pov, city, roller].slice(0, count);
---
<span class={`flex ${cls}`} aria-hidden="true">
  {imgs.map((src, i) => (
    <Image
      src={src}
      alt=""
      width={size * 2}
      height={size * 2}
      class="rounded-full object-cover object-top"
      style={`width:${size}px;height:${size}px;margin-left:${i ? -size * 0.32 : 0}px;box-shadow:0 0 0 2px ${ring};position:relative;z-index:${10 - i}`}
    />
  ))}
</span>
