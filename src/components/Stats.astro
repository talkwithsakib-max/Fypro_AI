---
import AvatarStack from "./ui/AvatarStack.astro";

// Compact metrics, modelled on Aave's "Building the future" and Robot.com's "Already working at scale":
// the heading sits beside a small bento of numbers, each number carrying one tiny visual instead of a full chart.

// Dot matrix for 4M+: viral columns per row (16 cols × 7 rows), from the Figma "Metric / Videos" matrix (567:19073)
const viralRows = [[3, 4], [1, 2, 3, 6], [3, 4, 8], [1, 2, 3, 7, 15], [0, 2, 6, 14, 15], [0, 13, 14], [0, 11, 12, 14]];
// Rising weekly views for 10M+
const weeks = [25, 31, 36, 42, 49, 56, 64, 73, 84, 95, 109, 140];
---

<section id="engine" class="pt-24 pb-24 sm:pt-[120px] sm:pb-[120px]" aria-labelledby="engine-title">
  <div class="container-x">
    <div class="mx-auto grid max-w-[1198px] items-center gap-12 lg:grid-cols-[minmax(0,1.08fr)_minmax(0,1fr)] lg:gap-14">
      <!-- Heading -->
      <div data-reveal>
        <p class="eyebrow">The engine behind the engine</p>
        <h2 id="engine-title" class="h2 mt-[18px] text-ink">Built only for your growth.<br /><span class="text-muted">Tuned by experts.</span></h2>
        <p class="lead mt-[18px] max-w-[440px]">Trained on millions of videos and sharpened every week by 30,000+ creators and the strategists behind them.</p>
      </div>

      <!-- Bento -->
      <div class="grid gap-3 sm:grid-cols-2 sm:grid-rows-2">
        <!-- 4M+: dot matrix -->
        <article class="stat sm:row-span-2" data-reveal style="--d:80ms">
          <div>
            <p class="stat-num">4M+</p>
            <h3 class="stat-label">Viral TikToks analyzed</h3>
          </div>
          <div class="mt-auto pt-8" aria-hidden="true">
            <div class="grid grid-cols-[repeat(16,minmax(0,1fr))] gap-[5px]">
              {viralRows.map((row) =>
                Array.from({ length: 16 }, (_, c) => (
                  <span class:list={["aspect-square rounded-full", row.includes(c) ? "dot-hot" : "bg-[#e3e4ec]"]}></span>
                ))
              )}
            </div>
            <p class="mt-3 flex items-center gap-1.5 text-[12px] font-medium text-muted"><i class="dot-hot size-2 rounded-full"></i>Patterns that went viral</p>
          </div>
        </article>

        <!-- 30,000+: faces -->
        <article class="stat" data-reveal style="--d:160ms">
          <div>
            <p class="stat-num">30,000+</p>
            <h3 class="stat-label">Creators every week</h3>
          </div>
          <div class="mt-auto flex items-center gap-2.5 pt-6">
            <AvatarStack size={30} count={5} ring="#f4f4f7" />
            <span class="flex items-center gap-1.5 text-[12px] font-medium text-muted"><i class="live size-1.5 rounded-full bg-[#0a8f8b]"></i>Active now</span>
          </div>
        </article>

        <!-- 10M+: rising bars -->
        <article class="stat" data-reveal style="--d:240ms">
          <div>
            <p class="stat-num">10M+</p>
            <h3 class="stat-label">Views last quarter</h3>
          </div>
          <div class="mt-auto flex h-16 items-end gap-[5px] pt-6" aria-hidden="true">
            {weeks.map((h, i) => (
              <span class="bar flex-1 rounded-[4px]" style={`height:${Math.round((h / 140) * 100)}%;--i:${i}`}></span>
            ))}
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    min-height: 190px;
    border-radius: 22px;
    background: #f4f4f7;
    padding: 24px;
  }
  .stat-num {
    font-family: var(--font-display);
    font-size: 52px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.05em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    margin-top: 10px;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 22px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-muted);
  }
  .dot-hot {
    background: linear-gradient(160deg, var(--color-cyan), var(--color-pink));
    box-shadow: 0 2px 6px -1px #fe2c5559;
  }
  .bar {
    background: linear-gradient(180deg, var(--color-pink), #fe2c5533);
    opacity: calc(0.35 + var(--i) * 0.06);
    transform-origin: bottom;
  }
  .bar:last-child { background: linear-gradient(180deg, var(--color-cyan), var(--color-pink)); opacity: 1; }
  :global(.js) .stat .bar { scale: 1 0; transition: scale 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: calc(300ms + var(--i) * 45ms); }
  :global(.js) .stat:global(.is-in) .bar { scale: 1 1; }
  .live { animation: live 1.6s ease-in-out infinite; }
  @keyframes live { 50% { opacity: 0.3; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .stat .bar { scale: 1 1; transition: none; }
    .live { animation: none; }
  }
</style>
