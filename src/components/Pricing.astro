---
import SectionHeading from "./ui/SectionHeading.astro";
import Arrow from "./ui/Arrow.astro";

const plans = [
  {
    name: "Free", tagline: "Start with your audience", price: "$0", credits: "100 credits", cta: "Start for free",
    lead: "Key features",
    features: ["8 viral ideas for your niche", "Watermarked AI videos", "Starter creator site", "Up to 10 dropshipping products", "1 GB storage"],
  },
  {
    name: "Pro", tagline: "Turn content into income", price: "$29", credits: "600 credits / month", cta: "Subscribe to Pro", featured: true,
    lead: "Everything in Free, plus",
    features: ["Advanced TikTok account analysis", "Unlimited viral ideas, breakdowns & scripts", "Seedance 2.0 video generation", "Watermark-free AI videos", "Unlimited dropshipping products", "Accept payments on your creator site", "Card rates from 2.8% + $0.30", "300 GB storage"],
  },
  {
    name: "Max", tagline: "For high-volume creators", price: "$200", credits: "7,000 credits / month", cta: "Subscribe to Max",
    lead: "Everything in Pro, plus",
    features: ["More credits for high-volume creation", "Access to advanced AI models", "Card rates from 2.6% + $0.30", "2 TB storage"],
  },
];
---

<section id="pricing" class="pt-24 pb-24 sm:pt-[120px] sm:pb-[132px]" aria-labelledby="pricing-title">
  <div class="container-x">
    <SectionHeading
      id="pricing-title"
      eyebrow="Pricing"
      title="Plans that grow with"
      muted="your channel."
      lead="Start free. Upgrade when your content starts turning into income."
    />

    <div class="mx-auto mt-14 grid max-w-[440px] gap-5 md:max-w-none md:grid-cols-3">
      {plans.map((p, i) => (
        <article
          class:list={["relative flex flex-col rounded-[28px] p-8 md:min-h-[649px] lg:h-[649px]", p.featured ? "pro text-white" : "bg-white"]}
          style={`--d:${i * 100}ms;box-shadow: var(${p.featured ? "--shadow-dark-card" : "--shadow-card"})`}
          data-reveal
        >
          <div class="flex items-start justify-between">
            <div>
              <h3 class="text-[23px] leading-[29px] font-semibold tracking-[-0.02em]">{p.name}</h3>
              <p class:list={["mt-0.5 text-[14px] leading-[17px]", p.featured ? "text-white/60" : "text-muted"]}>{p.tagline}</p>
            </div>
            {p.featured && (
              <span class="rounded-full bg-gradient-to-r from-cyan via-[#b77a96] to-pink px-2.5 py-1 text-[11.5px] font-semibold text-white shadow-[0_6px_16px_-6px_#fe2c55aa]">✦ Most popular</span>
            )}
          </div>

          <p class="mt-6 flex items-baseline gap-1.5">
            <span class="font-display text-[58px] leading-[74px] font-semibold tracking-[-0.03em]">{p.price}</span>
            <span class:list={["text-[15px]", p.featured ? "text-white/60" : "text-muted"]}>/ month</span>
          </p>

          <span class:list={["mt-6 inline-flex h-[29px] w-fit items-center gap-1.5 rounded-full px-3 text-[14px] font-semibold", p.featured ? "bg-white/10" : "bg-[#f4f4f6]"]}>
            <span class={p.featured ? "text-cyan" : "text-pink"}>✦</span>{p.credits}
          </span>

          {p.featured ? (
            <a href="#cta" class="glow-btn group relative mt-6 flex h-12 items-center justify-between rounded-full bg-gradient-to-b from-[#26272f] to-[#0f1015] py-1.5 pr-1.5 pl-5 text-[15px] font-medium ring-1 ring-white/10 transition-transform hover:-translate-y-px" style="box-shadow: var(--shadow-dark-float)">
              {p.cta}<span class="btn-orb"><Arrow /></span>
            </a>
          ) : (
            <a href="#cta" class="btn-light mt-6 h-12 w-full !py-0 font-semibold">{p.cta}</a>
          )}

          <p class:list={["mt-6 text-[14px] leading-[17px]", p.featured ? "text-white/60" : "text-muted"]}>{p.lead}</p>
          <ul class="mt-3 space-y-3 text-[15px] leading-[19px] lg:whitespace-nowrap">
            {p.features.map((f) => (
              <li class="flex gap-3">
                <span class:list={["grid size-[18px] shrink-0 place-items-center rounded-full", p.featured ? "bg-teal/25 text-cyan" : "bg-[#f1f1f4] text-ink"]}>
                  <svg class="size-2.5" viewBox="0 0 12 12" fill="none"><path d="m2.5 6.2 2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {f}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <p class="mt-14 text-center leading-[20px]">
      <a href="#" class="inline-flex items-center gap-1.5 text-[15px] font-medium hover:underline">Compare all features <Arrow class="size-3.5" /></a>
    </p>
  </div>
</section>

<style>
  .pro {
    background:
      radial-gradient(70% 40% at 0% 100%, #1d4b4a55 0%, transparent 70%),
      radial-gradient(70% 40% at 100% 100%, #4a142455 0%, transparent 70%),
      linear-gradient(180deg, #24252c 0%, #0d0e12 100%);
  }
</style>
