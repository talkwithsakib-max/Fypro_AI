---
import Logo from "./Logo.astro";

const links = [
  { label: "Features", href: "#features", menu: true },
  { label: "Free tools", href: "#how-it-works", menu: true },
  { label: "Creator Store", href: "#creators" },
  { label: "Pricing", href: "#pricing" },
  { label: "Resources", href: "#faq", menu: true },
];
---

<header class="relative z-40">
  <div class="flex h-9 items-center justify-center px-4 text-[13px] text-muted">
    <a href="#cta" class="group inline-flex items-center gap-2.5 rounded-full">
      <span class="rounded-full bg-[#d6fbf9] px-2 py-0.5 text-[11.5px] font-semibold text-[#0e8f8a]">New</span>
      <span class="hidden sm:inline">Fypro just launched at VidCon 2026.</span>
      <span class="sm:hidden">Launched at VidCon 2026.</span>
      <span class="font-medium text-pink underline underline-offset-2 decoration-pink/40 group-hover:decoration-pink">Try it free →</span>
    </a>
  </div>

  <nav class="mx-auto mt-3 flex h-14 max-w-[1440px] items-center justify-between gap-4 px-4 sm:px-6 lg:px-10" aria-label="Main">
    <a href="/" class="shrink-0" aria-label="Fypro home">
      <Logo class="h-9 w-auto" />
    </a>

    <ul
      class="hidden items-center rounded-full bg-white/80 p-[5px] backdrop-blur-xl lg:flex"
      style="box-shadow: var(--shadow-xs)"
    >
      {links.map((l, i) => (
        <li>
          <a
            href={l.href}
            class:list={[
              "flex h-[38px] items-center gap-1 rounded-full px-[14px] text-[15px] font-medium transition-colors",
              i === 0 ? "bg-[#f2f2f5] text-ink" : "text-ink/80 hover:bg-[#f5f5f7] hover:text-ink",
            ]}
          >
            {l.label}
            {l.menu && (
              <svg class="size-3.5 opacity-50" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2 sm:gap-5">
      <a href="#" class="hidden text-[15px] font-medium text-ink/85 hover:text-ink sm:inline">Log in</a>
      <a href="#cta" class="btn-dark !hidden sm:!inline-flex">
        Get started free
        <span class="btn-orb" aria-hidden="true">
          <svg class="size-4" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
      <button
        id="nav-toggle"
        class="grid size-11 place-items-center rounded-full bg-white lg:hidden"
        style="box-shadow: var(--shadow-xs)"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="size-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path class="nav-l1 origin-center transition-transform duration-300" d="M3 7h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path class="nav-l2 origin-center transition-transform duration-300" d="M3 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute inset-x-4 top-full mt-3 origin-top scale-95 rounded-[24px] bg-white/95 p-3 opacity-0 backdrop-blur-xl transition duration-300 lg:hidden"
    style="box-shadow: var(--shadow-float)"
  >
    <ul class="flex flex-col">
      {links.map((l) => (
        <li><a href={l.href} class="block rounded-2xl px-4 py-3 text-[17px] font-medium hover:bg-[#f5f5f7]">{l.label}</a></li>
      ))}
      <li class="mt-2 grid grid-cols-2 gap-2 border-t border-line pt-3">
        <a href="#" class="btn-light">Log in</a>
        <a href="#cta" class="btn-light !bg-ink !text-white">Get started</a>
      </li>
    </ul>
  </div>
</header>

<style>
  header:has(#nav-toggle[aria-expanded="true"]) #mobile-menu {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  #nav-toggle[aria-expanded="true"] .nav-l1 { transform: translateY(3px) rotate(45deg); }
  #nav-toggle[aria-expanded="true"] .nav-l2 { transform: translateY(-3px) rotate(-45deg); }
</style>

<script>
  const btn = document.getElementById("nav-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  const set = (open: boolean) => {
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };
  btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
  menu.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) set(false);
  });
  document.addEventListener("keydown", (e) => e.key === "Escape" && set(false));
</script>
